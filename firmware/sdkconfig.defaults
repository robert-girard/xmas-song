CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Verified on the KeeYees ESP32-D0WDQ6 rev 1.0: BOOT drives GPIO0 low.
# Disable this option when building for any board without this verified wiring.
CONFIG_XMAS_BUTTON_GPIO_VERIFIED=y
CONFIG_XMAS_BUTTON_GPIO=0
